[Unit]
Description=bt-indicator: SNI tray icon for Bluetooth
After=default.target

[Service]
# The daemon runs through venv-run (its shebang), which lives on ~/bin; a --user
# service inherits no login PATH, so name ~/bin explicitly. It reads BlueZ on
# the SYSTEM bus and registers its item on the SESSION bus.
Environment=PATH=%h/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/bt-indicator
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
