# test/harness_lib - harness for bt-sane's shell tests (test/*.t), sourced
# by each.
#
# Call `harness_init <name>`: sets HERE (the repo root, so a test reaches bin/ +
# setup.sh), a private scratch dir T (removed on exit), and the pass/fail
# helpers. Everything a test touches is confined to T; nothing outside it is
# written. POSIX sh; run one with `sh test/<name>.t`, all with test/run.
harness_init() {   # <name>
  TEST_NAME=$1
  HERE=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
  # The scratch dir is CHECKED, then its literal baked into the trap when it
  # is armed: a deferred `rm -rf "$T"` deletes whatever T holds at exit, and
  # an empty or wrong value there is how mux's harness removed its own repo.
  T=$(mktemp -d) || :
  case $T in
  /?*) [ -d "$T" ] || { echo "harness: mktemp gave '$T'" >&2; exit 1; } ;;
  *) echo "harness: mktemp -d failed (TMPDIR=${TMPDIR:-})" >&2; exit 1 ;;
  esac
  _C="'$T'"
  # shellcheck disable=SC2064
  trap "rm -rf $_C" EXIT INT TERM
}
pass() { printf 'ok   %s%s\n' "$TEST_NAME" "${1:+ ($1)}"; }
fail() { printf 'FAIL %s: %s\n' "$TEST_NAME" "$1" >&2; exit 1; }
skip() { printf 'skip %s (%s)\n' "$TEST_NAME" "$1"; exit 0; }
